{
  "name": "flaw",
  "private": true,
  "type": "module",
  "description": "Monorepo pnpm du projet Flaw.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "lint": "eslint . && node scripts/check-dom-sink-lint.mjs",
    "typecheck": "pnpm --filter \"./apps/**\" --filter \"./packages/**\" typecheck",
    "test": "vitest run --passWithNoTests --exclude apps/server/src/platform/healthz.test.ts && node --test apps/server/src/platform/healthz.test.ts",
    "licenses:check": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  }
}
