        "$type": "fontFamily",
        "$value": "Flaw Espace Fine"
      },
      "fichier": "polices/SourceSerif4-Regular.ttf.woff2",
      "unicode-range": "U+202F",
      "largeur": {
        "$type": "dimension",
        "$value": "0.125em"
      },
      "$description": "Police de repli limitée à U+202F, en tête de chaque pile (aucun woff2 de la famille ne contient U+202F). Source Serif 4 Regular d'Adobe 4.005, non modifiée. PDF : covers dans Typst. Voir polices-specifications.md § 4-5."
    },
    "typographie-francaise": {
      "$description": "F20, design v2.1 (final pour la v1) : caractère d'espace à insérer automatiquement, par mode et par signe. U+202F = espace fine insécable, U+00A0 = espace insécable normale. Position : « avant » = entre le mot et le signe (ou entre le mot et ») ; « après » = entre « et le mot. Au changement de mode, les espaces posées par F20 sont converties selon cette table.",
      "signes": {
        "point-virgule": {
          "signe": ";",
          "position": "avant"
        },
        "deux-points": {
          "signe": ":",
          "position": "avant"
        },
        "exclamation": {
          "signe": "!",
          "position": "avant"
        },
        "interrogation": {
          "signe": "?",
          "position": "avant"
        },
        "guillemet-ouvrant": {
          "signe": "«",
          "position": "après"
        },
        "guillemet-fermant": {
          "signe": "»",
          "position": "avant"
        }
      },
      "roman": {
        "point-virgule": "U+202F",
        "deux-points": "U+00A0",
        "exclamation": "U+202F",
        "interrogation": "U+202F",
        "guillemet-ouvrant": "U+00A0",
        "guillemet-fermant": "U+00A0"
      },
      "document": {
        "point-virgule": "U+202F",
        "deux-points": "U+00A0",
        "exclamation": "U+202F",
        "interrogation": "U+202F",
        "guillemet-ouvrant": "U+00A0",
        "guillemet-fermant": "U+00A0"
      },
      "page-blanche": {
        "point-virgule": "U+202F",
        "deux-points": "U+00A0",
        "exclamation": "U+202F",
        "interrogation": "U+202F",
        "guillemet-ouvrant": "U+00A0",
        "guillemet-fermant": "U+00A0"
      },
      "script": {
        "$description": "Courier Prime, chasse fixe : insécable normale partout pour garder les colonnes alignées",
        "point-virgule": "U+00A0",
        "deux-points": "U+00A0",
        "exclamation": "U+00A0",
        "interrogation": "U+00A0",
        "guillemet-ouvrant": "U+00A0",
        "guillemet-fermant": "U+00A0"
      },
      "interface": {
        "$description": "Textes de l'interface (Inter) : même règle que roman, document et page blanche",
        "point-virgule": "U+202F",
        "deux-points": "U+00A0",
        "exclamation": "U+202F",
        "interrogation": "U+202F",
        "guillemet-ouvrant": "U+00A0",
        "guillemet-fermant": "U+00A0"
      }
    },
