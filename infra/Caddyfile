# Caddyfile — Flaw (modèle v0.4, chemins infra/).
# Certificat HTTPS pour {$FLAW_DOMAIN}, redirection HTTP -> HTTPS.
{
	admin off
	email {$ACME_EMAIL}
}

{$FLAW_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 12MB
	}

	tls {
		protocols tls1.2 tls1.3
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://{$FLAW_DOMAIN}; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Frame-Options "DENY"
		X-DNS-Prefetch-Control "off"
		X-Permitted-Cross-Domain-Policies "none"
		-Server
		-X-Powered-By
	}

	header /api/* Cache-Control "no-store"

	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		header_up -X-Forwarded-For
	}
}
