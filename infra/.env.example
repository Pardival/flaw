# =============================================================================
# Flaw — variables d'environnement (modèle v0.4, dossier infra/)
# -----------------------------------------------------------------------------
# Copier en ".env" à côté du docker-compose.yml : cp .env.example .env
# puis : chmod 600 .env   (propriétaire : l'utilisateur d'administration)
# Ce fichier ne contient AUCUN secret : les secrets sont des FICHIERS dans
# ./secrets/ (montés sous /run/secrets), voir la section « Secrets » en bas.
# Le .env réel et le dossier secrets/ ne doivent JAMAIS être commités.
# L'application refuse de démarrer si un secret manque, fait moins de
# 32 octets ou vaut une valeur d'exemple (SEC-SECRET-07).
# Les sauvegardes locales et hors site sont la tâche T-042.
# =============================================================================

# --- Public / réseau ----------------------------------------------------------
# Domaine public servi en HTTPS par Caddy (certificat Let's Encrypt automatique).
# UNE SEULE variable : elle est propagée à Caddy (site, certificat, CSP), à
# PUBLIC_URL / BETTER_AUTH_URL, à la liste des origines autorisées (contrôle
# de l'en-tête Origin, REST et WebSocket) ; cookies sans attribut Domain (liés
# à cet hôte) ; manifeste PWA en URL relatives. Changer de domaine = changer
# cette ligne puis `docker compose up -d` (les sessions existantes sont perdues,
# les appareils se reconnectent ; les données locales non synchronisées
# restent attachées à l'ancienne origine : synchroniser AVANT de changer).
# Nom à choisir par Kevin : un .com ou un .fr (Kevin réside dans l'UE, le .fr
# est donc possible). Domaine DÉDIÉ à Flaw, sans sous-domaine hébergé par un
# tiers (condition du cookie __Secure- en v1).
# En local : FLAW_DOMAIN=localhost (certificat interne Caddy).
FLAW_DOMAIN=flaw.example.com
# Adresse transmise à Let's Encrypt (avis d'expiration). Pas un secret.
ACME_EMAIL=admin@example.com
# Réseau « edge » à sous-réseau FIXE et IP FIXE de Caddy (G3) : l'application
# n'accepte X-Real-IP que depuis CADDY_IP/32 (TRUSTED_PROXY_CIDR dérivé dans le
# docker-compose). Changer seulement en cas de collision avec un réseau existant.
EDGE_SUBNET=172.31.250.0/24
CADDY_IP=172.31.250.10

# --- Image applicative ---------------------------------------------------------
# Image publiée par la CI (GitHub Actions -> GHCR), référencée par version ET
# empreinte (SEC-CONT-01, SEC-SUPPLY-08). Jamais « latest ».
# En T-002, un build local est toléré pour le test seulement.
FLAW_IMAGE=ghcr.io/CHANGE_ME/flaw:0.1.0@sha256:CHANGE_ME

# --- Application ---------------------------------------------------------------
LOG_LEVEL=info
# v1 = un seul utilisateur : inscription publique fermée (SEC-AUTH-03).
# Le compte est créé avec : docker compose exec app flaw-admin create-user
ALLOW_SIGNUP=false
# Sessions : 30 jours d'inactivité, 90 jours maximum (SEC-SESS-04, à valider)
SESSION_IDLE_DAYS=30
SESSION_MAX_DAYS=90
# Fréquence de revalidation des sessions sur les WebSocket ouvertes (SEC-SESS-05)
SESSION_REVALIDATE_SECONDS=30
# Limites (SEC-API-03) : un roman entier fait ~1 à 5 Mo d'état CRDT
MAX_DOCUMENT_SIZE_MB=10
MAX_WS_MESSAGE_MB=10
# Repli serveur de l'export PDF (le PDF est généré d'abord sur l'appareil) :
# processus enfant tué au-delà du délai ou de la mémoire (G6 ; 300 000 mots ≈ 650 Mo)
EXPORT_TIMEOUT_SECONDS=60
EXPORT_MAX_CONCURRENCY=1
EXPORT_MAX_RSS_MB=900
# Mot de passe : 15 caractères par défaut ; plancher 8 codé en dur, l'application
# refuse de démarrer en dessous (G10, SEC-AUTH-02)
PASSWORD_MIN_LENGTH=15
# Instantanés des textes (F17) : tous conservés pendant N jours
SNAPSHOT_RETENTION_DAYS=30
# Identifiant de la clé maître courante (rotation, SEC-DATA-06). La clé elle-même
# (secrets/flaw_kek) doit faire EXACTEMENT 32 octets une fois décodée du base64,
# sinon l'application refuse de démarrer (G12).
FLAW_KEK_ID=kek-2026-10
# Poivre des codes de secours (H1), distinct de la KEK.
RECOVERY_PEPPER_ID=pep-2026-10
RECOVERY_PEPPER_OLD_IDS=
# Poivre HMAC des identifiants (verifications, rate_limits, auth_events).
# Secret dédié secrets/hmac_pepper, 32 octets, distinct de recovery_pepper.
HMAC_PEPPER_ID=pep-hmac-2026-10

# --- Alertes (SEC-LOG-05) -------------------------------------------------------
# URL de notification (ex. sujet ntfy privé) recevant un POST texte.
# Vide = désactivé. Messages SANS contenu, titre, e-mail ni IP complète (G11).
ALERT_WEBHOOK_URL=

# --- Base de données PostgreSQL --------------------------------------------------
POSTGRES_DB=flaw
# Utilisateurs : « postgres » (administration) et « flaw_app »
# (application, non superutilisateur), créés automatiquement.

# --- Pas d'OAuth (décision de Kevin) ni d'e-mail en v1 -------------------------------
# Mot de passe oublié : docker compose exec app flaw-admin reset-password --email <adresse>

# =============================================================================
# Secrets : fichiers dans ./secrets/, UN propriétaire par fichier = l'UID du
# conteneur qui le lit, droits 400 (440 pour le secret partagé app/db), JAMAIS
# 644 (G1, SEC-SECRET-06). Tout est fait par :
#   sudo sh creer-secrets.sh
#   sudo sh creer-secrets.sh --verifier
#
#   Secret              Lu par                     Propriétaire  Droits
#   postgres_password   db (UID 70)                70:70         400
#   app_db_password     app (10001), db            10001:70      440
#   db_owner_password   migrate (10001), db (70)   10001:70      440
#   better_auth_secret  app (10001)                10001:10001   400
#   flaw_kek            app (10001)                10001:10001   400
#   recovery_pepper     app (10001)                10001:10001   400
#   hmac_pepper         app (10001)                10001:10001   400
#
# Équivalent manuel (si le script ne peut pas être utilisé) :
#   sudo install -d -m 700 -o root -g root secrets
#   openssl rand -base64 32 | tr -d '\n' | sudo tee secrets/flaw_kek > /dev/null
#   sudo chown 10001:10001 secrets/flaw_kek && sudo chmod 400 secrets/flaw_kek
#   (idem pour chaque ligne du tableau)
# Copier flaw_kek ET recovery_pepper dans le gestionnaire de mots de passe
# + une copie hors ligne, avec l'empreinte affichée par le script :
# sans eux, les textes chiffrés sont IRRÉCUPÉRABLES.
# =============================================================================
