{
  "openapi": "3.1.0",
  "info": {
    "title": "Flaw",
    "version": "0.0.0"
  },
  "paths": {
    "/api/v1/healthz": {
      "get": {
        "operationId": "health",
        "summary": "Sonde de vie (sans authentification)",
        "security": [],
        "responses": {
          "200": {
            "description": "Sonde de vie",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Erreur générique (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceProblem"
                }
              }
            }
          },
          "413": {
            "description": "Erreur générique (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceProblem"
                }
              }
            }
          },
          "500": {
            "description": "Erreur générique (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "compte"
        ],
        "summary": "Profil de l'utilisateur connecté",
        "operationId": "getMe",
        "description": "API-001 (v0.4.18). Profil du compte connecté. Ne renvoie JAMAIS de haché,\nde secret TOTP, de code de secours ni de jeton. Les préférences restent\nsur GET /me/preferences (non incluses ici). Réponse non mise en cache.\n",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profil",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/MfaRequired"
          }
        }
      }
    },
    "/api/v1/me/sessions": {
      "get": {
        "tags": [
          "compte"
        ],
        "summary": "Liste des sessions actives (type d'appareil, navigateur, système, dernière activité ; aucune localisation)",
        "operationId": "listSessions",
        "responses": {
          "200": {
            "description": "Sessions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Session"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/MfaRequired"
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "compte"
        ],
        "summary": "Révoquer toutes les autres sessions (« déconnecter les autres appareils »)",
        "description": "Ré-authentification récente exigée (G9).",
        "operationId": "revokeOtherSessions",
        "responses": {
          "204": {
            "description": "Sessions révoquées"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ReauthRequired"
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/me/sessions/{sessionId}": {
      "delete": {
        "tags": [
          "compte"
        ],
        "summary": "Révoquer une session précise (effet immédiat, WebSocket comprises)",
        "operationId": "revokeSession",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Session révoquée"
          },
          "403": {
            "$ref": "#/components/responses/MfaRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/documents": {
      "get": {
        "operationId": "listDocuments",
        "summary": "Documents du compte connecté",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Documents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "documents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "documents"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Authentification requise",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents/{id}": {
      "delete": {
        "operationId": "deleteDocument",
        "summary": "Supprime un document du compte connecté",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Supprimé"
          },
          "401": {
            "description": "Authentification requise",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedBody"
                }
              }
            }
          },
          "403": {
            "description": "Accès refusé",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Erreur générique (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-flaw_session",
        "description": "Cookie de session (HttpOnly, Secure, SameSite=Lax, Path=/, SANS Domain :\nlié à l'hôte FLAW_DOMAIN). v1 : __Secure-flaw.session_token (accepté par\nl'Expert, réponse a, domaine dédié sans sous-domaine tiers) ; passage à\n__Host- avant la version publique (SEC-SESS-02).\n"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Jeton de session opaque (module auth maison, haché SHA-256 en base), pour l'app mobile"
      }
    },
    "headers": {
      "CacheControlNoStore": {
        "description": "Toujours no-store (v0.4.18, getMe ; règle générale de l'API)",
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Non authentifié",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "MfaRequired": {
        "description": "Session restreinte : second facteur (TOTP) non vérifié ou non enrôlé : type .../mfa_required (v0.4.18)",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControlNoStore"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "ReauthRequired": {
        "description": "Ré-authentification récente requise (mot de passe + TOTP de moins de 5 min) : type .../reauth_required",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "Introuvable (ou non autorisé : même réponse, pour ne rien révéler)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "role",
          "locale",
          "timeZone",
          "mfaEnrolled",
          "passwordMustChange"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          },
          "locale": {
            "type": "string",
            "example": "fr-FR"
          },
          "timeZone": {
            "type": "string",
            "example": "Asia/Ho_Chi_Minh"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "mfaEnrolled": {
            "type": "boolean",
            "description": "v0.4.18 (ajout) : TOTP enrôlé. Ni secret ni code."
          },
          "passwordMustChange": {
            "type": "boolean",
            "description": "v0.4.18 (ajout) : mot de passe provisoire (flaw-admin), changement exigé"
          }
        },
        "description": "Jamais de password_hash, secret TOTP, code de secours ni jeton (v0.4.18)."
      },
      "Session": {
        "type": "object",
        "required": [
          "id",
          "current",
          "createdAt",
          "lastSeenAt",
          "expiresAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "current": {
            "type": "boolean",
            "description": "Session de la requête en cours"
          },
          "deviceType": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "desktop",
              "tablet",
              "phone",
              null
            ],
            "description": "Type d'appareil (icône) ; aucune ville, aucun pays, aucune IP exposée (cahier v0.7)"
          },
          "deviceLabel": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "Firefox · macOS"
            ],
            "description": "Navigateur et système"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ServiceProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "about:blank"
          },
          "status": {
            "anyOf": [
              {
                "type": "number",
                "const": 400
              },
              {
                "type": "number",
                "const": 404
              },
              {
                "type": "number",
                "const": 413
              },
              {
                "type": "number",
                "const": 500
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "not_found",
              "payload_too_large",
              "internal_error"
            ]
          }
        },
        "required": [
          "type",
          "status",
          "title",
          "code"
        ],
        "additionalProperties": false
      },
      "UnauthorizedBody": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "about:blank"
          },
          "status": {
            "type": "number",
            "const": 401
          },
          "title": {
            "type": "string",
            "const": "Authentification requise"
          },
          "code": {
            "type": "string",
            "const": "unauthorized"
          }
        },
        "required": [
          "type",
          "status",
          "title",
          "code"
        ],
        "additionalProperties": false
      },
      "DocumentTitle": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
